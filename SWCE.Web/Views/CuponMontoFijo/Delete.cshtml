@model SWCE.Web.Models.CuponMontoFijo.CuponMontoFijoModel

@{
    ViewData["Title"] = "DeleteConfirmed";
}

<h1>Confirmar Eliminación</h1>

<h3>Estás seguro que deseas eliminarlo?</h3>
<div>
    <h4>UpdateCuponMontoFijoModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.monto)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.monto)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.fechaExpiracion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.fechaExpiracion)
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed">
        @Html.HiddenFor(model => model.id)
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>
