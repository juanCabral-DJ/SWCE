@using SWCE.Web.Models.Cupones.CuponPorcentaje
@model IEnumerable<CuponPorcentajeModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Administración Cupones Porcentaje</h1>

<p>
    <a asp-action="Create">Crear Nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.porcentaje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaExpiracion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.isDeleted)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.porcentaje)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaExpiracion)
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.isDeleted)*@
                    <input type="checkbox" disabled @(item.isDeleted ? "checked" : "") />
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.id}) |
                @Html.ActionLink("Details", "Details", new { id=item.id}) |
                @Html.ActionLink("Delete", "Delete", new { id=item.id})
            </td>
        </tr>
}
    </tbody>
</table>
