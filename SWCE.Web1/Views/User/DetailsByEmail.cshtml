@using SWCE.Web1.Models.User
@model UserModel

@{
    ViewData["Title"] = "User by email";
}

<h1>User by email</h1>

    <div>
        <h4>Usuario</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                Nombre
            </dt>
            <dd class="col-sm-10">
                @Model.nombre
            </dd>
            <dt class="col-sm-2">
                Apellido
            </dt>
            <dd class="col-sm-10">
                @Model.apellido
            </dd>
            <dt class="col-sm-2">
                Email
            </dt>
            <dd class="col-sm-10">
                @Model.email
            </dd>
            <dt class="col-sm-2">
                Fecha de Creación
            </dt>
            <dd class="col-sm-10">
                @Model.fecha_Creacion
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.id">Editar</a> |
        <a asp-action="Index">Volver a la lista</a>
    </div>

