@using SWCE.Web1.Models.User
@model IEnumerable<UserModel>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    <a asp-action="Create">Create New Users</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Apellido
            </th>
            <th>
                Email
            </th>
            <th>
                Fecha de Creación
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.nombre
                </td>
                <td>
                    @item.apellido
                </td>
                <td>
                    @item.email
                </td>
                <td>
                    @item.fecha_Creacion.ToShortDateString()
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.id">Update</a> |
                    <a asp-action="DetailsByEmail" asp-route-email="@item.email">Obtener por el email</a> |
                    <a asp-action="Details" asp-route-id="@item.id">Obtener por el id</a> |
                    <a asp-action="Delete" asp-route-id="@item.id" class="text-danger">Disable</a>
                </td>
            </tr>
        }
    </tbody>
</table>
