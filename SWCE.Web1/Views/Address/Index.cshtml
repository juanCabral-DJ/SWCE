@model IEnumerable<SWCE.Web1.Models.Address.AddressModel>

@{
    ViewData["Title"] = "Direcciones";
}

<h1>Addresses</h1>

<p>
    <a asp-action="Create">Create New Address</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Id del usuario
            </th>
            <th>
                Calle
            </th>
            <th>
                Ciudad
            </th>
            <th>
                Estado o Provincia
            </th>
            <th>
                Codigo postal
            </th>
            <th>
                Pais
            </th>
            <th>
               ¿Es Predeterminada?
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @(item.id)
            </td>
            <td>
                    @(item.iD_Usuario)
            </td>
            <td>
                    @(item.calle) 
            </td>
            <td>
                    @(item.ciudad) 
            </td>
            <td>
                    @(item.estado_provincia) 
            </td>
            <td>
                    @(item.codigo_postal) 
            </td>
            <td>
                    @(item.pais)
            </td>
            <td>
                    @(item.es_predeterminada? "Si" : "No")
            </td>

            <td>
                    <a asp-action="Edit" asp-route-id="@item.id">Update Address</a> |
                    <a asp-action="DetailsByUserid" asp-route-iD_Usuario="@item.iD_Usuario">Addresses by userid</a> |
                    <a asp-action="Details" asp-route-id="@item.id">Address By Id</a> |
                    <a asp-action="Delete" asp-route-id="@item.id" class="text-danger">Disable Address</a> |
                    <a asp-action="DetailsByPredeterminada" asp-route-iD_Usuario="@item.iD_Usuario">Address by Predeterminada</a>

            </td>
        </tr>
}
    </tbody>
</table>
