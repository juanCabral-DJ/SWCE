@model IEnumerable<SWCE.Web1.Models.Address.AddressModel>

@{
    ViewData["Title"] = "Addresses by userid";
}

<h1>Addresses by userid</h1>

 
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Id del usuario
            </th>
            <th>
                Calle
            </th>
            <th>
                Ciudad
            </th>
            <th>
                Estado o provincia
            </th>
            <th>
                Codigo postal
            </th>
            <th>
                Pais
            </th>
            <th>
                ¿Es predeterminada?
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.id)
            </td>
            <td>
                @(item.iD_Usuario)
            </td>
            <td>
                @(item.calle)
            </td>
            <td>
                @(item.ciudad)
            </td>
            <td>
                @(item.estado_provincia)
            </td>
            <td>
                @(item.codigo_postal)
            </td>
            <td>
                @(item.pais)
            </td>
            <td>
                @(item.es_predeterminada? "Si" : "No")
            </td>
            <td>
                 
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-action="Index">Back to List</a>
</div>
