@model IEnumerable<SWCE.Web1.Models.Address.AddressModel>

@{
    ViewData["Title"] = "DetailsByUserid";
}

<h1>DetailsByUserid</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
