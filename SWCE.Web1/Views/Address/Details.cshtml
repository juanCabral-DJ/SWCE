@model SWCE.Web1.Models.Address.AddressModel

@{
    ViewData["Title"] = "Address By Id";
}

<h1>Address By Id</h1>

<div>
    <h4>Address</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Id
        </dt>
        <dd class="col-sm-10">
            @(Model.id)
        </dd>
        <dt class="col-sm-2">
            Id del usuario
        </dt>
        <dd class="col-sm-10">
            @(Model.iD_Usuario)
        </dd>
        <dt class="col-sm-2">
            Calle
        </dt>
        <dd class="col-sm-10">
            @(Model.calle)
        </dd>
        <dt class="col-sm-2">
            Ciudad
        </dt>
        <dd class="col-sm-10">
            @(Model.ciudad)
        </dd>
        <dt class="col-sm-2">
            Estado o provincia
        </dt>
        <dd class="col-sm-10">
            @(Model.estado_provincia)
        </dd>
        <dt class="col-sm-2">
            Codigo postal
        </dt>
        <dd class="col-sm-10">
            @(Model.codigo_postal)
        </dd>
        <dt class="col-sm-2">
            Pais
        </dt>
        <dd class="col-sm-10">
            @(Model.pais)
        </dd>
        <dt class="col-sm-2">
            ¿Es predeterminada?
        </dt>
        <dd class="col-sm-10">
            @(Model.es_predeterminada ? "Si" : "No")
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new {  id = Model.id }) |
    <a asp-action="Index">Back to List</a>
</div>
