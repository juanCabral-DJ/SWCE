@model IEnumerable<SWCE.Web1.Models.WishListItem.ItemModel>

@{
    ViewData["Title"] = "WishListItem";
}

<h1>WishListItem</h1>

<p>
    <a asp-action="Create">Create New Item</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Id del producto
            </th>
            <th>
                id del usuario
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.id)
            </td>
            <td>
                @(item.id_producto)
            </td>
            <td>
                @(item.id_Usuario)
            </td>
            <td>
                    <a asp-action="DetailsbyUserid" asp-route-id_Usuario="@item.id_Usuario">Obtener por el id del usuario</a> |
                    <a asp-action="Details" asp-route-id="@item.id">Item by id</a> |
                    <a asp-action="Delete" asp-route-id_Usuario="@item.id" class="text-danger">Disable item</a>
                     
            </td>
        </tr>
}
    </tbody>
</table>
