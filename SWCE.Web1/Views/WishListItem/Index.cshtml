@model IEnumerable<SWCE.Web1.Models.WishListItem.ItemModel>

@{
    ViewData["Title"] = "WishListItem";
}

<h1>WishListItem</h1>

<p>
    <a asp-action="Create">Create New Item</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_producto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.isDeleted)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_producto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_Usuario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.isDeleted)
            </td>
            <td>
                    @Html.ActionLink("Item by id", "Details", new { id = item.id }) |
                    @Html.ActionLink("Item by UserId", "DetailsbyUserId", new { id  = item.id_Usuario }) |
                    @Html.ActionLink("Disable item", "Delete", new { id = item.id }, new { @class = "text-danger" })
            </td>
        </tr>
}
    </tbody>
</table>
