@model IEnumerable<SWCE.Web1.Models.WishListItem.ItemModel>

@{
    ViewData["Title"] = "Item By Userid";
}

<h1>Item By Userid</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Id del producto
            </th>
            <th>
                Id del usuario
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.id)
            </td>
            <td>
                @(item.id_producto)
            </td>
            <td>
                @(item.id_Usuario)
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-action="Index">Back to List</a>
